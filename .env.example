GWANGJU_SERVICE_KEY=
REDIS_URL=redis://localhost:6379/0

# 콜렉터가 모니터링할 노선(콤마 구분). 비워두면 lineInfo로 전체를 가져오려 시도합니다(권장X).
MONITORED_LINE_IDS=1,2,3

# 버스가 종점에서 "사라짐"으로 간주되는 시간(초)
LAYOVER_MISSING_SEC=60

# line:{id}:history 유지 길이(30초 주기 기준 10분이면 20개 정도)
LINE_HISTORY_MAXLEN=40

# (옵션) 모델 경로
MODEL_PATH=
